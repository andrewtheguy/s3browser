# S3 Browser Environment Variables
# Copy this file to .env and fill in the values

# Login password for the web UI (must be at least 16 characters)
# Required from either this env var OR ~/.s3browser/login.password file
# Generate a secure password with: openssl rand -base64 32
S3BROWSER_LOGIN_PASSWORD=REPLACE_ME_WITH_ACTUAL_PASSWORD

# Encryption key for S3 credentials (must be at least 32 characters)
# Required from either this env var OR ~/.s3browser/encryption.key file
# Generate a secure key with: openssl rand -hex 32
S3BROWSER_ENCRYPTION_KEY=REPLACE_ME_WITH_ACTUAL_KEY

# Presigned URL TTL choices shown in the preview/file list "copy URL" actions.
# Comma-delimited list. Each entry is one positive integer + one unit:
#   h = hours, d = days, w = weeks. Mixing units in one entry (e.g. "1d2h") is not allowed.
# Each entry must not exceed 7 days (AWS S3 SigV4 maximum); larger values are dropped.
# Defaults to "1h,1d" if unset or empty.
# Read by the server, so changes take effect on server restart
# without rebuilding the frontend.
# Examples: S3BROWSER_PRESIGNED_URL_TTLS=1h,1d
#           S3BROWSER_PRESIGNED_URL_TTLS=6h,1d,7d
# S3BROWSER_PRESIGNED_URL_TTLS=1h,1d

# Allowlist of S3 endpoint hostnames for which local key search and the
# indexing CLI are enabled. Listing a bucket via ListObjectsV2 is expensive,
# so search/indexing is disabled for every connection by default and must be
# opted in per endpoint host.
#
# Comma-delimited list of hostnames. Match is exact (case-insensitive) against
# the hostname parsed from the connection's saved endpoint URL.
# Connections with no explicit endpoint (AWS) match the literal "s3.amazonaws.com".
# If unset or empty, search and indexing are disabled for ALL connections.
# Read by the server, so changes take effect on server restart.
# Examples: S3BROWSER_SEARCH_WHITELIST_HOSTS=s3.amazonaws.com
#           S3BROWSER_SEARCH_WHITELIST_HOSTS=minio.example.com,objstore.local
# S3BROWSER_SEARCH_WHITELIST_HOSTS=
